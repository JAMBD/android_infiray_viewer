<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/manualRangeOverlay"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#40000000">

            <EditText
                android:id="@+id/rangeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="±2.0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:padding="4dp"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

            <FrameLayout
                android:id="@+id/seekBarContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <SeekBar
                    android:id="@+id/rangeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="39"
                    android:progress="3" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/manualTopBottomOverlay"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#40000000">

            <EditText
                android:id="@+id/topTempLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="40.0"
                android:textColor="#FFFF4444"
                android:textSize="10sp"
                android:padding="4dp"
                android:gravity="center"
                android:inputType="numberDecimal|numberSigned"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

            <FrameLayout
                android:id="@+id/topBottomSeekBarContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <SeekBar
                    android:id="@+id/bottomTempSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="4400"
                    android:progress="600" />

                <SeekBar
                    android:id="@+id/topTempSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="4400"
                    android:progress="800" />

            </FrameLayout>

            <EditText
                android:id="@+id/bottomTempLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20.0"
                android:textColor="#FF4488FF"
                android:textSize="10sp"
                android:padding="4dp"
                android:gravity="center"
                android:inputType="numberDecimal|numberSigned"
                android:background="@android:color/transparent"
                android:imeOptions="actionDone"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

        </LinearLayout>

    </FrameLayout>

    <!-- First row for Capture Image and Capture Raw buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/getImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture Image" />

        <Button
            android:id="@+id/getFrameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture Raw" />
    </LinearLayout>

    <!-- Second row for Start Video and Stop Video buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/startVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Video" />

        <Button
            android:id="@+id/stopVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Video"
            android:enabled="false" />
    </LinearLayout>

    <!-- Bottom row for Ctrl and Settings buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/gainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings" />
    </LinearLayout>
</LinearLayout>
